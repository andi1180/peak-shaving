{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "preserve",
    "noEmit": true,
    "allowJs": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      // Die generierten Supabase-Typen liegen im Repo-Root (eine Datei für die ganze Plattform),
      // nicht in dieser App. Gleicher Alias wie in `apps/web` — es soll nicht zwei Schreibweisen für
      // dieselbe Datei geben. Reiner Typ-Import, zur Laufzeit nichts.
      "@/db-types": ["../../supabase/database.types"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
